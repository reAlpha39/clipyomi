{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipYomi",
  "version": "0.1.0",
  "identifier": "dev.jparser.clipyomi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ClipYomi",
        "titleBarStyle": "Overlay",
        "visible": false,
        "width": 720,
        "height": 480,
        "minWidth": 160,
        "minHeight": 80,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
